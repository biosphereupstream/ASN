{
  "name": "asnnet-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "build": "bun run --cwd frontend build",
    "preview": "bun run --cwd frontend preview",
    "typecheck": "bun run --cwd frontend check && bun run --cwd backend typecheck",
    "db:seed": "bun run --cwd backend db:seed"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0"
  }
}
